# Palworld game-server config. Copy to .env and edit. Everything is optional
# except a strong ADMIN_PASSWORD. Blank values fall back to the game's ini
# defaults. This file is consumed by docker-compose.yml (env_file).

# ─── Identity ────────────────────────────────────────────────────────────────
SERVER_NAME=My Palworld Server
SERVER_DESCRIPTION=
# Strong admin password — also used by the dashboard (PALWORLD_ADMIN_PASSWORD)
# and by RCON. Alphanumeric is safest (it's passed through several layers).
ADMIN_PASSWORD=change-me-strong-and-alphanumeric
# Server join password; blank = public.
SERVER_PASSWORD=
MAX_PLAYERS=32

# ─── Network ─────────────────────────────────────────────────────────────────
PORT=8211
QUERY_PORT=27015
# Enable RCON + REST — the dashboard needs BOTH.
RCON_ENABLED=true
RCON_PORT=25575
REST_API_ENABLED=true
REST_API_PORT=8212
# Only for NAT / multi-homed hosts (advertises an address; doesn't change listen).
PUBLIC_IP=
PUBLIC_PORT=

# ─── Mods ────────────────────────────────────────────────────────────────────
# UE4SS (MIT) is fetched + installed on first boot. Set false to run vanilla.
ENABLE_UE4SS=true
# PalDefender (MIT), optional. Set true AND point PALDEFENDER_URL at a release
# zip to auto-install; or drop the files into ./game/Pal/Binaries/Win64 yourself.
ENABLE_PALDEFENDER=false
PALDEFENDER_URL=

# ─── Gameplay (blank = ini default) ──────────────────────────────────────────
COMMUNITY=false
MULTITHREADING=true
CROSSPLAY_PLATFORMS=Steam,Xbox,PS5,Mac
ENABLE_PVP=false
DIFFICULTY=
DEATH_PENALTY=
EXP_RATE=
PAL_CAPTURE_RATE=
WORK_SPEED_RATE=
# (See the entrypoint for the full list of supported rate/limit vars.)

# ─── Maintenance ─────────────────────────────────────────────────────────────
# Pin to a Steam manifest to avoid a game update breaking UE4SS.
TARGET_MANIFEST_ID=
ALWAYS_UPDATE_ON_START=false
BACKUP_ENABLED=false
BACKUP_CRON_EXPRESSION=0 0 * * *
DELETE_OLD_BACKUPS=false
BACKUP_RETENTION_DAYS=30
TZ=UTC
